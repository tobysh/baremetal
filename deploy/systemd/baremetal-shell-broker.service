[Unit]
Description=Baremetal shell broker (unprivileged: sessions, limits, guest byte stream)
Documentation=file:///opt/baremetal-shell/docs/shell-deployment.md
Requires=baremetal-shell-launcher.service
After=baremetal-shell-launcher.service

[Service]
Type=simple
User=baremetal-shell-broker
# Primary group is the one the web service joins (SupplementaryGroups=baremetal-shell-client in baremetal-web.service);
# the broker socket therefore gets that group. Access to the launcher socket is a second, separate group.
Group=baremetal-shell-client
SupplementaryGroups=baremetal-shell-launch
Slice=baremetal-shell.slice
WorkingDirectory=/opt/baremetal-shell
ExecStart=/usr/bin/env node --jitless --import tsx scripts/shell-broker.mts
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin
# Variables read by scripts/shell-broker.mts. The broker gets no kernel, rootfs, jailer or chroot path: VMs come from
# the launcher.
Environment=SHELL_BROKER_SOCKET=/run/baremetal-shell-broker/broker.sock
Environment=SHELL_LAUNCHER_SOCKET=/run/baremetal-shell/launcher.sock
# Must equal the launcher's SHELL_MAX_VMS; the slice is sized for 16 (docs/shell-deployment.md, "Resource sizing").
Environment=SHELL_MAX_SESSIONS=16
Environment=SHELL_IDLE_SECONDS=300
Environment=SHELL_MAX_SECONDS=1800
# VM time per account per UTC day (in memory; a broker restart resets it).
Environment=SHELL_DAILY_SECONDS=7200
# Optional overrides only; never put secrets here, the broker has none.
EnvironmentFile=-/etc/baremetal-shell/broker.env
# Applied after EnvironmentFile=: the development-only unjailed mode can never be switched on from an env file.
UnsetEnvironment=SHELL_MODE FIRECRACKER SHELL_KERNEL SHELL_ROOTFS
UMask=0007
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group

MemoryAccounting=yes
TasksAccounting=yes
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=2048
LimitCORE=0

# --- Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProcSubset=pid
ProtectProc=invisible
# The two socket directories (created by tmpfiles.d): its own listening socket, and the launcher's socket to connect to.
ReadWritePaths=/run/baremetal-shell-broker
ReadOnlyPaths=/run/baremetal-shell
# Each VM's vsock socket is a root:baremetal-shell-launch 0660 link in /var/lib/baremetal-shell/jail/sockets (see
# exposeSocket in src/lib/shell/vm.ts). The broker sees only that directory: the rest of /var/lib/baremetal-shell (the
# per-VM chroots) is replaced by an empty read-only tmpfs and the socket directory is bound into it read-only.
# Connecting to a Unix socket needs write permission on the socket inode, not a writable mount. UNVERIFIED on a real
# host; if the bind fails, fall back to ReadOnlyPaths=/var/lib/baremetal-shell/jail/sockets without the tmpfs.
TemporaryFileSystem=/var/lib/baremetal-shell:ro
BindReadOnlyPaths=/var/lib/baremetal-shell/jail/sockets
InaccessiblePaths=-/etc/baremetal -/var/lib/baremetal -/opt/baremetal-web -/opt/baremetal-runner -/root -/boot -/usr/local/share/baremetal-shell -/usr/local/libexec/baremetal-shell
NoExecPaths=/run/baremetal-shell /run/baremetal-shell-broker /var/lib/baremetal-shell
ExecPaths=/usr /opt/baremetal-shell

# --- Network: Unix sockets only (path-based sockets work across network namespaces).
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# --- Privileges: none.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectClock=yes
ProtectHostname=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @module @reboot @swap @raw-io @obsolete @cpu-emulation @clock
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
