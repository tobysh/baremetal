# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/blob-report/
/playwright/.auth/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*.swo
*~

# local caches and scratch directories
/.cache/
/tmp/
/temp/

# Python content-generation tooling
__pycache__/
*.py[cod]
/.venv/
/venv/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/*.log
/*.pid
/*.pid.lock
*.sock

# local env files; sanitized example templates may be committed
.env*
!.env.example
!.env.*.example

# local AWS credentials and configuration
/.aws/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local MongoDB data
/.data

# generated local VM images (keep lesson fixtures under content/ visible)
/*.ext4
/vmlinux
/scripts/shell/*.ext4
/scripts/shell/vmlinux

.claude/

# browser regression artifacts
/test-results/
/playwright-report/
