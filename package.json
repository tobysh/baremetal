{
  "name": "baremetal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:content": "tsx scripts/verify-curriculum.mts",
    "db": "mongod --dbpath .data/db --bind_ip 127.0.0.1 --port 27017 --quiet",
    "make-admin": "tsx --env-file=.env.local scripts/make-admin.mts",
    "test:e2e": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/e2e-auth.mts",
    "flagged-accounts": "tsx --env-file=.env.local scripts/flagged-accounts.mts",
    "sweep-orphans": "tsx --env-file-if-exists=.env.local scripts/sweep-orphans.mts",
    "recompute-xp": "tsx --env-file=.env.local scripts/recompute-xp.mts",
    "backfill-achievements": "tsx --env-file=.env.local scripts/backfill-achievements.mts",
    "check:ids": "tsx scripts/check-lesson-ids.mts",
    "check:theme": "tsx scripts/check-theme.mts",
    "backup-db": "tsx --env-file=.env.local scripts/backup-db.mts",
    "restore-db": "tsx --env-file=.env.local scripts/restore-db.mts",
    "check:set-values": "tsx scripts/checks/set-values.mts",
    "check:stdout-order": "tsx scripts/checks/stdout-order.mts",
    "test:concurrent-go": "tsx scripts/runner/concurrent-go.mts",
    "load:run-mix": "tsx scripts/load/run-mix.mts",
    "check:learning": "tsx scripts/checks/learning.mts",
    "test:regressions": "tsx scripts/checks/regressions.mts",
    "test:runner": "node --conditions=react-server --import tsx scripts/runner/transport-checks.mts",
    "test:browser": "playwright test",
    "runner": "tsx scripts/runner-service.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
